<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#121212"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:padding="32dp">

    <!-- 海报：内嵌封面，无封面时显示 ♪ -->
    <FrameLayout
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_marginTop="24dp"
        android:background="#1E1E1E">

        <ImageView
            android:id="@+id/iv_poster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_poster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="♪"
            android:textColor="#333333"
            android:textSize="90sp" />
    </FrameLayout>

    <!-- 歌名 / 艺术家 -->
    <TextView
        android:id="@+id/tv_p_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:text="—" />

    <TextView
        android:id="@+id/tv_p_artist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="20dp"
        android:textColor="#888888"
        android:textSize="14sp"
        android:singleLine="true"
        android:text="—" />

    <!-- 三个按钮：上一首 / 播放暂停 / 下一首 -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btn_prev"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_media_previous" />

        <ImageButton
            android:id="@+id/btn_play"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_marginLeft="28dp"
            android:layout_marginRight="28dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_media_play" />

        <ImageButton
            android:id="@+id/btn_next"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_media_next" />
    </LinearLayout>

    <!-- 歌词 / 播放列表 切换 -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/tab_playlist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="播放列表"
            android:textSize="13sp"
            android:minWidth="0dp" />

        <Button
            android:id="@+id/tab_lyrics"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="歌词"
            android:textSize="13sp"
            android:minWidth="0dp"
            android:layout_marginLeft="8dp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp">

        <!-- 播放列表 -->
        <ListView
            android:id="@+id/lv_playlist"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="#222222"
            android:dividerHeight="1dp" />

        <!-- 歌词（.smi 同名文件） -->
        <LinearLayout
            android:id="@+id/lyrics_panel"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_lrc_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#555555"
                android:textSize="12sp"
                android:text="" />

            <ListView
                android:id="@+id/lv_lyrics"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="8dp"
                android:divider="@null"
                android:scrollbars="none" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
